# Copy to .env and fill in. Never commit .env.
# At least one of Sonarr / Radarr must be configured.

SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=

# Optional
PROWLARR_URL=http://192.168.1.10:9696
PROWLARR_API_KEY=

# true disables (does not register) every write tool
ARR_READONLY=false
# HTTP timeout in seconds
ARR_TIMEOUT=15
# Download folder as seen by Sonarr/Radarr (inside the container).
# Leave empty to detect it from the queue and import history.
ARR_DOWNLOADS_PATH=
# Language of error messages and notes: en (default) or es
ARR_LANG=en

# Guardrails (see docs/GOOD_PRACTICES.md)
# Max searches/grabs/indexer tests per hour (0 = unlimited)
ARR_INDEXER_BUDGET_PER_HOUR=30
# Searches or queue removals over this many items need confirm=true
ARR_SEARCH_CONFIRM_ABOVE=10
# Skip items searched less than N minutes ago (0 = off)
ARR_SEARCH_COOLDOWN_MINUTES=60
